<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime : Autorisations requises pour Recall -->
    <!-- Connexions sortantes (vérification mises à jour GitHub, télémétrie Google Sheets) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Connexions entrantes (serveur local Wi-Fi Compagnon Téléphone SSE) -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Chargement sécurisé des bibliothèques système (ex: sqlite3 Serato/Rekordbox) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Accès aux fichiers nécessaires pour les bases de données DJ et logs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
