<Window x:Class="Recall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Recall"
        mc:Ignorable="d"
        Title="Recall"
        Width="360" Height="530"
        MinWidth="300" MaxWidth="560"
        MinHeight="54" MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Icon="Resources/AppIcon.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Styles pour les boutons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222834" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3748" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1E232D" BorderBrush="#374151" BorderThickness="1" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0FA2FF"/>
                                <Setter Property="Foreground" Value="#0FA2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToPlayChipStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1E232D" BorderBrush="#374151" BorderThickness="1" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D2E0A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFB300"/>
                                <Setter Property="Foreground" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#F012151A" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- ==================== VUE NORMALE ==================== -->
            <Grid x:Name="NormalViewGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- En-tête -->
                    <RowDefinition Height="Auto" /> <!-- Now Playing Card -->
                    <RowDefinition Height="Auto" /> <!-- Filter Bar -->
                    <RowDefinition Height="*" />    <!-- Suggestions List -->
                </Grid.RowDefinitions>

                <!-- 1. En-tête (Logo, Compteur, Actions) -->
                <Grid Grid.Row="0" Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Recall Vinyl -->
                        <Ellipse Width="18" Height="18" Fill="#14C8B0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#14C8B0" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Recall" FontWeight="Bold" FontSize="14" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        
                        <!-- Compteur Session -->
                        <Border Background="#1C2F3D" BorderBrush="#254B68" BorderThickness="1" CornerRadius="10" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺ " FontSize="10" Foreground="#14C8B0" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSessionCount" Text="0" FontSize="10" Foreground="#14C8B0" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Boutons En-tête Droite -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCollapse" Content="→ Réduire" Style="{StaticResource ActionButtonStyle}" Click="BtnCollapse_Click" ToolTip="Passer en mode bandeau compact" Margin="0,0,4,0"/>
                        <Button x:Name="BtnSettings" Content="⚙" Style="{StaticResource ActionButtonStyle}" Click="BtnSettings_Click" ToolTip="Paramètres et conformité" Margin="0,0,4,0"/>
                        <Button x:Name="BtnClose" Content="✕" Style="{StaticResource ActionButtonStyle}" Click="BtnClose_Click" ToolTip="Fermer Recall" />
                    </StackPanel>
                </Grid>

                <!-- 2. Carte Now Playing (Deck 1 / Deck 2) -->
                <Border Grid.Row="1" Background="#1A1E26" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="8" Margin="10,2,10,6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Sélecteur DECK & Statut -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#14C8B0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="EN COURS" FontSize="9" FontWeight="Bold" Foreground="#14C8B0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="RbAuto" Content="AUTO" IsChecked="True" GroupName="DeckGroup" Foreground="#9CA3AF" FontSize="9" Checked="DeckRadio_Checked" Margin="0,0,6,0"/>
                                <RadioButton x:Name="RbDeck1" Content="DECK 1" GroupName="DeckGroup" Foreground="#9CA3AF" FontSize="9" Checked="DeckRadio_Checked" Margin="0,0,6,0"/>
                                <RadioButton x:Name="RbDeck2" Content="DECK 2" GroupName="DeckGroup" Foreground="#9CA3AF" FontSize="9" Checked="DeckRadio_Checked"/>
                            </StackPanel>
                        </Grid>

                        <!-- Titre, Artiste, Key & BPM -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="32" Height="32" Fill="#242B38" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtNowTitle" Text="En attente de Serato DJ Pro..." FontWeight="Bold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtNowArtist" Text="Lancez un morceau" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="BadgeNowKey" Background="#3314C8B0" BorderBrush="#14C8B0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtNowKey" Text="--" FontSize="11" FontWeight="Bold" Foreground="#14C8B0"/>
                                </Border>
                                <Border Background="#222834" CornerRadius="4" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtNowBpm" Text="-- BPM" FontSize="10" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Bouton Sauvegarder ce combo -->
                        <Button Grid.Row="2" x:Name="BtnSaveCombo" Margin="0,8,0,0" Background="#33FF5252" BorderBrush="#FF5252" BorderThickness="1" Foreground="#FF7675" FontWeight="Bold" FontSize="10" Padding="0,4" Cursor="Hand" Click="BtnSaveCombo_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="♡ " FontWeight="Bold"/>
                                <TextBlock Text="Sauvegarder ce combo"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. Barre de Filtres Compacte -->
                <Grid Grid.Row="2" Margin="10,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkFilterBpm" Content="BPM ±8%" Style="{StaticResource FilterChipStyle}" Click="FilterChanged" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkFilterHarmonie" Content="Harmonie" Style="{StaticResource FilterChipStyle}" Click="FilterChanged" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkFilterFavs" Content="Favs" Style="{StaticResource FilterChipStyle}" Click="FilterChanged" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkFilterToPlay" Content="Sélec" Style="{StaticResource ToPlayChipStyle}" Click="FilterChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtMatchCount" Text="0 matchs" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 4. Liste des Suggestions -->
                <ListView Grid.Row="3" x:Name="ListSuggestions" Background="Transparent" BorderThickness="0" Margin="6,0,6,6"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseMove="ListSuggestions_PreviewMouseMove"
                          MouseDoubleClick="ListSuggestions_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Background="#161B22" BorderBrush="#252B37" BorderThickness="1" Margin="0,2" Padding="6,4">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🗑 Retirer de la sélec" Click="DeleteToPlay_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Index / Statut -->
                                    <TextBlock Text="{Binding TransitionCount, StringFormat='{}{0}x'}" FontSize="10" FontWeight="Bold" Foreground="#FF9F43" VerticalAlignment="Center"/>

                                    <!-- Titre & Artiste -->
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" FontSize="9.5" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Key & BPM -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="4" BorderThickness="1" BorderBrush="#55FFFFFF" Padding="4,1" Background="#222834" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding DisplayKey}" FontSize="9" FontWeight="Bold" Foreground="{Binding KeyColorHex}"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayBpm}" FontSize="9.5" FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ==================== VUE RÉDUITE (BANDEAU COMPACT) ==================== -->
            <Grid x:Name="CompactViewGrid" Visibility="Collapsed" Height="54" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & #1 match -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="#14C8B0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="#2214C8B0" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                        <TextBlock Text="#1" FontSize="9" FontWeight="Black" Foreground="#14C8B0"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                    <TextBlock x:Name="TxtCompactTitle" Text="Aucune suggestion" FontWeight="Bold" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="TxtCompactArtist" Text="Artiste" FontSize="9.5" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCompactKey" Text="--" FontSize="9" FontWeight="Bold" Foreground="#14C8B0" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCompactBpm" Text="-- BPM" FontSize="9" Foreground="#E5E7EB"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions Déplier & Fermer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExpand" Content="← Déplier" Style="{StaticResource ActionButtonStyle}" Click="BtnExpand_Click" ToolTip="Déplier la fenêtre Recall" Margin="0,0,4,0"/>
                    <Button Content="✕" Style="{StaticResource ActionButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Overlay Visuel de Glisser-Déposer -->
            <Border x:Name="DropOverlay" Background="#DD10141D" CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False">
                <Border BorderBrush="#14C8B0" BorderThickness="2" CornerRadius="14" Margin="6" Background="#2214C8B0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✚" FontSize="32" Foreground="#14C8B0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ajouter à la Sélec" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Déposez le morceau dans votre sélection" FontSize="10" Foreground="#A0AEC0" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
