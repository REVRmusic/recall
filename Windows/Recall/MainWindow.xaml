<Window x:Class="Recall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Recall"
        mc:Ignorable="d"
        Title="Recall"
        Width="360" Height="530"
        MinWidth="300" MaxWidth="560"
        MinHeight="54" MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Icon="Resources/AppIcon.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Boutons circulaires modernes style macOS pour l'en-tête -->
        <Style x:Key="HeaderCircleBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#1C222E"/>
            <Setter Property="Foreground" Value="#C5CDD9"/>
            <Setter Property="BorderBrush" Value="#2A3344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3748"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton Fermer circulaire avec survol rouge -->
        <Style x:Key="HeaderCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#1C222E"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="#2A3344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53935"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5252"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton Réduire / Déplier pilule -->
        <Style x:Key="CollapsePillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2214C8B0"/>
            <Setter Property="Foreground" Value="#14C8B0"/>
            <Setter Property="BorderBrush" Value="#6614C8B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3314C8B0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#14C8B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sélecteur de Platine Deck Pills (AUTO, DECK 1, DECK 2) sans puce ronde -->
        <Style x:Key="DeckPillStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#1E232D" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="4" Padding="5,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C384A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#14C8B0"/>
                                <Setter Property="Foreground" Value="#14C8B0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sélecteur de Direction de Transition Pills (Après, Avant, Tout) -->
        <Style x:Key="DirectionPillStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#1E232D" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3344"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtre Pilule BPM (Cyan) -->
        <Style x:Key="FilterChipBpmStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1A202A" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15394A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#14C8B0"/>
                                <Setter Property="Foreground" Value="#14C8B0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtre Pilule Harmonie (Violet) -->
        <Style x:Key="FilterChipHarmonieStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1A202A" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A1E3D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C471ED"/>
                                <Setter Property="Foreground" Value="#C471ED"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtre Pilule Favoris (Rouge) -->
        <Style x:Key="FilterChipFavsStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1A202A" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D1B1B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5252"/>
                                <Setter Property="Foreground" Value="#FF7675"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtre Pilule Sélec (Or) -->
        <Style x:Key="FilterChipToPlayStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#1A202A" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D2E0A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFB300"/>
                                <Setter Property="Foreground" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Bouton Compteur Session -->
        <Style x:Key="SessionPillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C2F3D"/>
            <Setter Property="BorderBrush" Value="#264D6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="6,1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#254359"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#14C8B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Bouton Sauvegarde Combo -->
        <Style x:Key="SaveComboBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#26FF5252"/>
            <Setter Property="BorderBrush" Value="#FF5252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF7675"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3DFF5252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Bouton Manuel Clear -->
        <Style x:Key="ManualClearBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3D280A"/>
            <Setter Property="Foreground" Value="#FF9F43"/>
            <Setter Property="BorderBrush" Value="#FF9F43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="5,1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style des lignes de ListView (supprime le bleu Windows par défaut) -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#F2101318" BorderBrush="#2AFFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- ==================== VUE NORMALE ==================== -->
            <Grid x:Name="NormalViewGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- En-tête -->
                    <RowDefinition Height="Auto" /> <!-- Now Playing Card -->
                    <RowDefinition Height="Auto" /> <!-- Filter Bar -->
                    <RowDefinition Height="*" />    <!-- Suggestions List -->
                </Grid.RowDefinitions>

                <!-- 1. En-tête (Logo, Compteur de Session cliquable, Actions style macOS) -->
                <Grid Grid.Row="0" Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : Logo + Compteur de Session -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Vinyle Recall avec effet de halo -->
                        <Border Width="20" Height="20" CornerRadius="10" Background="#14C8B0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#14C8B0" Opacity="0.55"/>
                            </Border.Effect>
                            <TextBlock Text="●" FontSize="11" Foreground="#101318" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Recall" FontWeight="Bold" FontSize="13" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>

                        <!-- Bouton Compteur / Reset de Session (Clic = Reset, Clic Droit = Stats) -->
                        <Button x:Name="BtnSessionReset" Margin="8,0,0,0" Style="{StaticResource SessionPillBtnStyle}" Click="BtnSessionReset_Click" MouseRightButtonUp="BtnSessionReset_RightClick" ToolTip="Démarrer un nouveau mix (clic gauche) / Statistiques du set (clic droit)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺ " FontSize="9" Foreground="#14C8B0" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSessionCount" Text="0" FontSize="9" Foreground="#14C8B0" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Droite : Actions Circulaires & Réduire -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCollapse" Content="↓ Réduire" Style="{StaticResource CollapsePillBtnStyle}" Click="BtnCollapse_Click" ToolTip="Passer en mode bandeau compact (Ctrl+Shift+C)" Margin="0,0,4,0"/>
                        <Button x:Name="BtnSearch" Content="🔍" FontSize="9.5" Style="{StaticResource HeaderCircleBtnStyle}" Click="BtnSearch_Click" ToolTip="Rechercher un morceau dans la bibliothèque (Ctrl+Shift+F)" Margin="0,0,3,0"/>
                        <Button x:Name="BtnStats" Content="📊" FontSize="9.5" Style="{StaticResource HeaderCircleBtnStyle}" Click="BtnStats_Click" ToolTip="Statistiques du mix - Set Recap (Ctrl+Shift+S)" Margin="0,0,3,0"/>
                        <Button x:Name="BtnGuide" Content="?" FontSize="10" FontWeight="Bold" Style="{StaticResource HeaderCircleBtnStyle}" Click="BtnGuide_Click" ToolTip="Guide et légende des symboles" Margin="0,0,3,0"/>
                        <Button x:Name="BtnSettings" Content="⚙" FontSize="10" Style="{StaticResource HeaderCircleBtnStyle}" Click="BtnSettings_Click" ToolTip="Paramètres et conformité" Margin="0,0,3,0"/>
                        <Button x:Name="BtnClose" Content="✕" FontSize="9" FontWeight="Bold" Style="{StaticResource HeaderCloseBtnStyle}" Click="BtnClose_Click" ToolTip="Fermer Recall" />
                    </StackPanel>
                </Grid>

                <!-- 2. Carte Now Playing (Deck 1 / Deck 2) avec Vinyle Réaliste -->
                <Border Grid.Row="1" Background="#161B23" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="9" Margin="10,2,10,6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Sélecteur DECK & Statut -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotNowStatus" Width="6" Height="6" Fill="#14C8B0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtNowStatus" Text="EN COURS" FontSize="8.5" FontWeight="Bold" Foreground="#14C8B0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnClearManual" Content="MANUEL ✕" Visibility="Collapsed" Style="{StaticResource ManualClearBtnStyle}" FontSize="8" FontWeight="Bold" Click="BtnClearManual_Click" Margin="0,0,5,0"/>

                                <RadioButton x:Name="RbAuto" Content="AUTO" IsChecked="True" GroupName="DeckGroup" Style="{StaticResource DeckPillStyle}" Checked="DeckRadio_Checked" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RbDeck1" Content="DECK 1" GroupName="DeckGroup" Style="{StaticResource DeckPillStyle}" Checked="DeckRadio_Checked" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RbDeck2" Content="DECK 2" GroupName="DeckGroup" Style="{StaticResource DeckPillStyle}" Checked="DeckRadio_Checked"/>
                            </StackPanel>
                        </Grid>

                        <!-- Titre, Artiste, Vinyle avec Macaron & Badges -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Vinyle Réaliste 34x34 avec macaron coloré Camelot -->
                            <Border Width="34" Height="34" CornerRadius="17" Background="#0C0E12" BorderBrush="#2AFFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid>
                                    <!-- Sillon vinyle -->
                                    <Border Width="24" Height="24" CornerRadius="12" BorderBrush="#15FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Macaron central coloré selon la clé -->
                                    <Border x:Name="VinylMacaron" Width="12" Height="12" CornerRadius="6" Background="#14C8B0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Trou central -->
                                        <Border Width="4" Height="4" CornerRadius="2" Background="#0C0E12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtNowTitle" Text="En attente de Serato DJ Pro..." FontWeight="Bold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtNowArtist" Text="Lancez un morceau sur Deck 1 ou 2" FontSize="10.5" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="BadgeNowKey" Background="#2614C8B0" BorderBrush="#14C8B0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtNowKey" Text="--" FontSize="10.5" FontWeight="Bold" Foreground="#14C8B0"/>
                                </Border>
                                <Border Background="#1F2633" CornerRadius="4" Padding="5,1.5" Margin="0,3,0,0" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtNowBpm" Text="-- BPM" FontSize="9.5" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Bouton Sauvegarder ce combo -->
                        <Button Grid.Row="2" x:Name="BtnSaveCombo" Margin="0,8,0,0" Style="{StaticResource SaveComboBtnStyle}" Click="BtnSaveCombo_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtSaveComboIcon" Text="♡ " FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSaveComboLabel" Text="Sauvegarder ce combo"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. Barre de Filtres avec Icônes & Compteur -->
                <Grid Grid.Row="2" Margin="10,0,10,5">
                    <StackPanel Orientation="Horizontal">
                        <!-- Sélecteur de direction d'enchaînement (Après / Avant / Tout) -->
                        <Border Background="#161B22" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadDirNext" Content="→ Après" Style="{StaticResource DirectionPillStyle}" GroupName="TransitionDir" IsChecked="True" Click="DirectionChanged" ToolTip="Transitions suivantes : Morceaux joués APRÈS (Par défaut)"/>
                                <RadioButton x:Name="RadDirPrev" Content="← Avant" Style="{StaticResource DirectionPillStyle}" GroupName="TransitionDir" Click="DirectionChanged" ToolTip="Transitions inversées : Morceaux joués AVANT (Introductions)"/>
                                <RadioButton x:Name="RadDirAll" Content="⇄ Tout" Style="{StaticResource DirectionPillStyle}" GroupName="TransitionDir" Click="DirectionChanged" ToolTip="Toutes les transitions : Avant et Après combinés"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkFilterBpm" Content="⏱ BPM ±8%" Style="{StaticResource FilterChipBpmStyle}" Click="FilterChanged" Margin="0,0,5,0"/>
                        <CheckBox x:Name="ChkFilterHarmonie" Content="☯ Harmonie" Style="{StaticResource FilterChipHarmonieStyle}" Click="FilterChanged" Margin="0,0,5,0"/>
                        <CheckBox x:Name="ChkFilterFavs" Content="❤️ Favs" Style="{StaticResource FilterChipFavsStyle}" Click="FilterChanged" Margin="0,0,5,0"/>
                        <CheckBox x:Name="ChkFilterToPlay" Content="★ Sélec" Style="{StaticResource FilterChipToPlayStyle}" Click="FilterChanged"/>
                    </StackPanel>

                    <Border Background="#1C222E" BorderBrush="#2A3344" BorderThickness="1" CornerRadius="5" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMatchCount" Text="0 match" FontSize="9.5" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                    </Border>
                </Grid>

                <!-- 4. Liste des Suggestions Modernisée (Parité macOS) -->
                <ListView Grid.Row="3" x:Name="ListSuggestions" Background="Transparent" BorderThickness="0" Margin="6,0,6,6"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseMove="ListSuggestions_PreviewMouseMove"
                          MouseDoubleClick="ListSuggestions_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" CornerRadius="6" Background="#151A22" BorderBrush="#222834" BorderThickness="1" Margin="0,1.5" Padding="7,4">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="❤️ Ajouter / Retirer des favoris" Click="ToggleFavorite_Click"/>
                                        <MenuItem Header="🗑 Retirer de la sélec" Click="DeleteToPlay_Click" />
                                        <MenuItem Header="📁 Afficher dans l'Explorateur" Click="OpenInExplorer_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" /> <!-- Rang / Flame -->
                                        <ColumnDefinition Width="*" />  <!-- Titre & Artiste -->
                                        <ColumnDefinition Width="Auto" /> <!-- Badges -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Index / Transition Count -->
                                    <TextBlock Text="{Binding TransitionCount, StringFormat='{}{0}x'}" FontSize="9.5" FontWeight="Bold" Foreground="#FF9F43" VerticalAlignment="Center"/>

                                    <!-- Titre & Artiste -->
                                    <StackPanel Grid.Column="1" Margin="4,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" FontSize="9" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Badges d'état & Clé & BPM -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Badge Joué dans la session -->
                                        <!-- Clé Camelot avec couleur authentique -->
                                        <Border CornerRadius="4" BorderThickness="1" BorderBrush="{Binding KeyColorHex}" Padding="4,1" Background="#1C212E" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding DisplayKey}" FontSize="9" FontWeight="Bold" Foreground="{Binding KeyColorHex}"/>
                                        </Border>

                                        <!-- BPM -->
                                        <Border CornerRadius="4" Background="#1F2532" Padding="4,1">
                                            <TextBlock Text="{Binding DisplayBpm}" FontSize="9" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ==================== VUE RÉDUITE (BANDEAU COMPACT) ==================== -->
            <Grid x:Name="CompactViewGrid" Visibility="Collapsed" Height="54" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & #1 match -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#14C8B0" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="●" FontSize="9" Foreground="#101318" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#2614C8B0" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                        <TextBlock Text="#1" FontSize="9" FontWeight="Black" Foreground="#14C8B0"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                    <TextBlock x:Name="TxtCompactTitle" Text="Aucune suggestion" FontWeight="Bold" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="TxtCompactArtist" Text="Artiste" FontSize="9" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCompactKey" Text="--" FontSize="9" FontWeight="Bold" Foreground="#14C8B0" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCompactBpm" Text="-- BPM" FontSize="9" Foreground="#E5E7EB"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions Déplier & Fermer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExpand" Content="↑ Déplier" Style="{StaticResource CollapsePillBtnStyle}" Click="BtnExpand_Click" ToolTip="Déplier la fenêtre Recall" Margin="0,0,4,0"/>
                    <Button Content="✕" Style="{StaticResource HeaderCloseBtnStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Overlay Visuel de Glisser-Déposer -->
            <Border x:Name="DropOverlay" Background="#DD10141D" CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False">
                <Border BorderBrush="#14C8B0" BorderThickness="2" CornerRadius="14" Margin="6" Background="#2214C8B0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✚" FontSize="32" Foreground="#14C8B0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ajouter à la Sélec" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Déposez le morceau dans votre sélection" FontSize="10" Foreground="#A0AEC0" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
