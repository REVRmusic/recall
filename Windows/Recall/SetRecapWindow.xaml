<Window x:Class="Recall.SetRecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recall - Statistiques du Mix"
        Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Border CornerRadius="12" Background="#161A22" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#2614C8B0" Margin="0,0,8,0">
                        <TextBlock Text="📊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Statistiques du Mix" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#2614C8B0" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SET RECAP" FontSize="8.5" FontWeight="Bold" Foreground="#14C8B0"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtSessionStatus" Text="Session en direct" FontSize="9.5" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- HERO CARD : Durée & Pacing -->
                    <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="DURÉE TOTALE DU SET" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtTotalDuration" Text="00m 00s" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                                    <TextBlock Text="MORCEAUX JOUÉS" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <TextBlock x:Name="TxtTotalTracks" Text="0" FontSize="26" FontWeight="Black" Foreground="#14C8B0"/>
                                        <TextBlock Text=" tracks" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#2A3140" Margin="0,10,0,10"/>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱ " FontSize="11" Foreground="#14C8B0"/>
                                    <TextBlock Text="Temps moyen : " FontSize="10" Foreground="#D1D5DB"/>
                                    <TextBlock x:Name="TxtAvgTimePerTrack" Text="--" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" / track" FontSize="9.5" Foreground="#9CA3AF"/>
                                </StackPanel>
                                <Border x:Name="BadgePacing" Background="#2614C8B0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtPacing" Text="En attente" FontSize="9" FontWeight="Bold" Foreground="#14C8B0"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GRILLE D'INDICATEURS CLÉS -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <!-- BPM Moyen -->
                        <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,6">
                            <StackPanel>
                                <TextBlock Text="BPM MOYEN" FontSize="8.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtAvgBpm" Text="-- BPM" FontSize="16" FontWeight="Bold" Foreground="#FF9F43" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtBpmRange" Text="Plage : --" FontSize="9" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tonalité Dominante -->
                        <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,0,6">
                            <StackPanel>
                                <TextBlock Text="TONALITÉ DOMINANTE" FontSize="8.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtDominantKey" Text="--" FontSize="16" FontWeight="Bold" Foreground="#C471ED" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtDominantKeyInfo" Text="En attente" FontSize="9" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Genre Dominant (User Request #1) -->
                        <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="GENRE DOMINANT" FontSize="8.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtDominantGenre" Text="--" FontSize="16" FontWeight="Bold" Foreground="#14C8B0" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtDominantGenreInfo" Text="En attente" FontSize="9" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Vitesse de Mix -->
                        <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="VITESSE DE MIX" FontSize="8.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtTracksPerHour" Text="-- tracks/h" FontSize="16" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                                <TextBlock Text="Cadence moyenne" FontSize="9" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- SECTION : GENRES LES PLUS JOUÉS (User Request #1) -->
                    <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎧 " FontSize="11" Foreground="#14C8B0"/>
                                    <TextBlock Text="GENRES LES PLUS JOUÉS" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTopGenreBadge" Text="" FontSize="9.5" FontWeight="SemiBold" Foreground="#14C8B0" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <StackPanel x:Name="PanelTopGenres">
                                <TextBlock x:Name="TxtNoGenres" Text="Genres musicaux en cours d'analyse..." FontSize="9.5" Foreground="#6B7280" Margin="0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : ARTISTES LES PLUS JOUÉS -->
                    <Border Background="#1C212C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👑 " FontSize="11" Foreground="#FFD700"/>
                                    <TextBlock Text="ARTISTES LES PLUS JOUÉS" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTopArtistBadge" Text="" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFD700" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel x:Name="PanelTopArtists">
                                <TextBlock x:Name="TxtNoArtists" Text="Artistes en cours d'analyse..." FontSize="9.5" Foreground="#6B7280" Margin="0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button Content="↺ Démarrer un nouveau set" Padding="10,5" Background="Transparent" Foreground="#FF7675" BorderThickness="1" BorderBrush="#FF5252" Cursor="Hand" Click="BtnResetSession_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copier le résumé" Padding="12,5" Background="#242B38" Foreground="White" BorderThickness="1" BorderBrush="#374151" Cursor="Hand" Click="BtnCopySummary_Click" Margin="0,0,8,0"/>
                    <Button Content="Fermer" Padding="16,5" Background="#14C8B0" Foreground="#12151A" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
